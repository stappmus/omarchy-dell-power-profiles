reload_power_rules() {
  local start_permissions=${1:-1}

  if [[ -x /usr/bin/systemctl ]]; then
    /usr/bin/systemctl daemon-reload || echo ":: Unable to reload systemd units for Dell power profiles." >&2
  fi

  if [[ ! -x /usr/bin/udevadm || ! -S /run/udev/control ]]; then
    return 0
  fi

  /usr/bin/udevadm control --reload-rules || echo ":: Unable to reload udev rules for Dell power profiles." >&2
  /usr/bin/udevadm trigger --action=add --subsystem-match=platform-profile ||
    echo ":: Unable to reapply Dell platform-profile permissions; they will be applied after reboot." >&2
  /usr/bin/udevadm trigger --action=add --subsystem-match=firmware-attributes ||
    echo ":: Unable to reapply Dell charging-profile permissions; they will be applied after reboot." >&2
  /usr/bin/udevadm settle || true

  if (( start_permissions )) && [[ -x /usr/bin/systemctl ]]; then
    /usr/bin/systemctl start omarchy-dell-power-profiles-permissions.service ||
      echo ":: Unable to apply Dell charging-profile permissions; they will be retried when the firmware device appears." >&2
  fi
}

restore_platform_profile_permissions() {
  local profile_dir

  for profile_dir in /sys/class/platform-profile/*; do
    [[ -r $profile_dir/name && -e $profile_dir/profile ]] || continue
    [[ $(<"$profile_dir/name") == "dell-pc" ]] || continue

    /usr/bin/chgrp root "$profile_dir/profile" 2>/dev/null || true
    /usr/bin/chmod g-w "$profile_dir/profile" 2>/dev/null || true
  done
}

restore_charging_profile_permissions() {
  local attributes_dir=/sys/class/firmware-attributes/dell-wmi-sysman/attributes
  local attribute
  local current_value

  for attribute in PrimaryBattChargeCfg CustomChargeStart CustomChargeStop; do
    current_value="$attributes_dir/$attribute/current_value"
    [[ -e $current_value ]] || continue

    /usr/bin/chgrp root "$current_value" 2>/dev/null || true
    /usr/bin/chmod g-rw "$current_value" 2>/dev/null || true
  done
}

post_install() {
  reload_power_rules
}

post_upgrade() {
  reload_power_rules
}

post_remove() {
  if [[ -x /usr/bin/systemctl ]]; then
    /usr/bin/systemctl stop omarchy-dell-power-profiles-permissions.service 2>/dev/null || true
  fi
  restore_platform_profile_permissions
  restore_charging_profile_permissions
  reload_power_rules 0
}
