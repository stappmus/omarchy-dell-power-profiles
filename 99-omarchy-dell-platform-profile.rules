ACTION=="add", SUBSYSTEM=="platform-profile", ATTR{name}=="dell-pc", RUN+="/usr/bin/chgrp wheel /sys/class/platform-profile/%k/profile"
ACTION=="add", SUBSYSTEM=="platform-profile", ATTR{name}=="dell-pc", RUN+="/usr/bin/chmod g+w /sys/class/platform-profile/%k/profile"

# Dell creates the charging attributes after announcing this device. Let a
# short-lived service wait for those exact files instead of racing their
# creation inside the udev event.
ACTION=="add", SUBSYSTEM=="firmware-attributes", KERNEL=="dell-wmi-sysman", TAG+="systemd", ENV{SYSTEMD_WANTS}+="omarchy-dell-power-profiles-permissions.service"
